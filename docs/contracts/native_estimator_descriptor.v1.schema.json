{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/schemas/native_estimator_descriptor.v1.schema.json",
  "title": "DAG-ML native estimator descriptor v1",
  "description": "TCV1-self-fingerprinted metadata read back from one complete N4ME fitted estimator state (Methods ABI 2.13).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptor_type",
    "schema_version",
    "artifact_sha256",
    "owner_controller",
    "format",
    "method_id",
    "roles",
    "capabilities",
    "descriptor_fingerprint"
  ],
  "properties": {
    "descriptor_type": { "const": "dagml.native_estimator_descriptor.v1" },
    "schema_version": { "const": 1 },
    "artifact_sha256": { "$ref": "#/$defs/sha256" },
    "owner_controller": {
      "enum": [
        "controller:n4m.transformer",
        "controller:n4m.selector",
        "controller:n4m.regressor",
        "controller:n4m.classifier",
        "controller:n4m.sample_filter",
        "controller:n4m.splitter",
        "controller:n4m.augmenter"
      ]
    },
    "format": { "const": "N4ME" },
    "method_id": { "type": "string", "minLength": 1 },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "transformer",
          "selector",
          "regressor",
          "classifier",
          "sample_filter",
          "splitter",
          "augmenter",
          "generic"
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "descriptor_fingerprint": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
