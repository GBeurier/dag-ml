{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/schemas/bound_training_output.v2.schema.json",
  "title": "DAG-ML BoundTrainingOutput v2",
  "description": "Versioned bound output. Legacy Final/CV payloads are unchanged. Only completed OOF-consuming model REFIT without Final blocks may bind an exact external-test cohort or an explicit artifact-only deployed predictor; native validation additionally requires its selected fitted artifact and REFIT lineage. Replay outputs forbid these training-only fields.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding",
    "predictions",
    "observation_predictions",
    "aggregated_predictions"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "binding": {
      "$ref": "https://github.com/GBeurier/dag-ml/schemas/output_binding.v1.schema.json"
    },
    "artifact_only": { "type": "boolean", "default": false },
    "refit_test_cohort": {
      "$ref": "https://github.com/GBeurier/dag-ml/schemas/coordinator_data_plan_envelope.v2.schema.json#/$defs/predict_cohort"
    },
    "predictions": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/GBeurier/dag-ml/schemas/node_result.v2.schema.json#/$defs/prediction_block"
      }
    },
    "observation_predictions": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/GBeurier/dag-ml/schemas/node_result.v2.schema.json#/$defs/observation_prediction_block"
      }
    },
    "aggregated_predictions": {
      "type": "array",
      "items": {
        "$ref": "https://github.com/GBeurier/dag-ml/schemas/node_result.v2.schema.json#/$defs/aggregated_prediction_block"
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["artifact_only"], "properties": { "artifact_only": { "const": true } } },
      "then": {
        "not": { "required": ["refit_test_cohort"] },
        "properties": {
          "binding": { "properties": { "prediction_source": { "const": "final_refit" } } },
          "predictions": { "maxItems": 0 },
          "observation_predictions": { "maxItems": 0 },
          "aggregated_predictions": { "maxItems": 0 }
        }
      },
      "else": { "anyOf": [
    { "properties": { "predictions": { "minItems": 1 } } },
    { "properties": { "observation_predictions": { "minItems": 1 } } },
    { "properties": { "aggregated_predictions": { "minItems": 1 } } }
      ] }
    },
    {
      "if": { "required": ["refit_test_cohort"] },
      "then": { "properties": {
        "binding": { "properties": { "prediction_source": { "const": "final_refit" }, "prediction_level": { "const": "sample" } } },
        "refit_test_cohort": { "properties": { "role": { "const": "external_test" } } },
        "predictions": { "minItems": 1, "items": { "properties": { "partition": { "const": "test" }, "fold_id": { "type": "null" } } } },
        "observation_predictions": { "maxItems": 0 },
        "aggregated_predictions": { "maxItems": 0 }
      } }
    }
  ]
}
