{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/schemas/conformal_presentation.v1.schema.json",
  "title": "DAG-ML conformal presentation v1",
  "description": "Transport-only scalar projection of a validated Package V2 PREDICT replay. Consumers render but never recompute intervals.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_fingerprint", "replay_outcome_fingerprint", "binding_id", "target_name", "sample_ids", "point_predictions", "intervals", "calibration_fingerprint", "presentation_fingerprint"],
  "properties": {
    "schema_version": {"const": 1},
    "package_fingerprint": {"$ref": "#/$defs/sha"},
    "replay_outcome_fingerprint": {"$ref": "#/$defs/sha"},
    "binding_id": {"$ref": "#/$defs/id"},
    "target_name": {"type": "string", "minLength": 1},
    "sample_ids": {"$ref": "#/$defs/sample_ids"},
    "point_predictions": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "intervals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/interval"}},
    "calibration_fingerprint": {"$ref": "#/$defs/sha"},
    "presentation_fingerprint": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sample_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage", "lower", "upper", "qhat"],
      "properties": {
        "coverage": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "lower": {"type": "array", "minItems": 1, "items": {"type": ["number", "null"]}},
        "upper": {"type": "array", "minItems": 1, "items": {"type": ["number", "null"]}},
        "qhat": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
