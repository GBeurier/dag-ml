{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/schemas/portable_predictor_package.v2.schema.json",
  "title": "DAG-ML PortablePredictorPackage v2",
  "description": "Closed V2 package. V1 deliberately has no conformal calibration or calibration replay evidence members.",
  "type": "object", "additionalProperties": false,
  "dependentRequired": {"conformal_calibration": ["conformal_calibration_replay"], "conformal_calibration_replay": ["conformal_calibration"]},
  "required": ["schema_version", "package_id", "template", "training_request_fingerprint", "training_outcome", "effective_plan", "execution_bundle", "output_bindings", "predictor_node_ids", "training_influence", "data_identities", "fitted_artifact_mode", "artifact_bindings", "package_fingerprint"],
  "properties": {
    "schema_version": {"const": 2}, "package_id": {"$ref": "#/$defs/id"}, "template": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/portable_predictor_package.v1.schema.json#/$defs/predictor_template"}, "training_request_fingerprint": {"$ref": "#/$defs/sha"}, "training_outcome": {"$ref": "#/$defs/training_outcome_ref"}, "effective_plan": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_plan.v1.schema.json"}, "execution_bundle": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json"},
    "conformal_calibration": {"anyOf": [{"$ref": "https://github.com/GBeurier/dag-ml/schemas/conformal_runtime_calibration.v2.schema.json"}, {"type": "null"}]}, "conformal_calibration_replay": {"anyOf": [{"$ref": "https://github.com/GBeurier/dag-ml/schemas/training_replay_outcome.v3.schema.json"}, {"type": "null"}]}, "output_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/output_binding.v1.schema.json"}}, "predictor_node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "training_influence": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/training_influence_manifest.v1.schema.json"}, "data_identities": {"type": "array", "minItems": 1, "items": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/training_request.v1.schema.json#/$defs/training_data_identity"}}, "fitted_artifact_mode": {"enum": ["portable_required", "allow_host_sidecar"]}, "artifact_bindings": {"type": "array", "items": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/portable_predictor_package.v1.schema.json#/$defs/artifact_binding"}}, "package_fingerprint": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "training_outcome_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome_id", "outcome_fingerprint", "training_request_fingerprint", "effective_plan_fingerprint", "execution_bundle_id", "execution_bundle_fingerprint", "output_binding_fingerprints", "training_influence_fingerprint", "data_identities_fingerprint"],
      "properties": {
        "outcome_id": {"$ref": "#/$defs/id"}, "outcome_fingerprint": {"$ref": "#/$defs/sha"}, "pre_conformal_outcome_fingerprint": {"$ref": "#/$defs/sha"}, "training_request_fingerprint": {"$ref": "#/$defs/sha"}, "effective_plan_fingerprint": {"$ref": "#/$defs/sha"}, "execution_bundle_id": {"$ref": "#/$defs/id"}, "execution_bundle_fingerprint": {"$ref": "#/$defs/sha"}, "output_binding_fingerprints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha"}}, "training_influence_fingerprint": {"$ref": "#/$defs/sha"}, "data_identities_fingerprint": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
