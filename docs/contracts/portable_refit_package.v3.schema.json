{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/schemas/portable_refit_package.v3.schema.json",
  "title": "DAG-ML PortableRefitPackage V3",
  "description": "Closed full-refit child package. It is a new family: V1/V2 PortablePredictorPackage readers must refuse it. It contains fresh target-training evidence and refit artifacts only; parent CV scores, OOF caches, selection reports, conformal state and runtime handles are not representable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "package_id", "outcome", "package_fingerprint"],
  "properties": {
    "schema_version": {"const": 3},
    "package_id": {"$ref": "#/$defs/id"},
    "outcome": {"$ref": "#/$defs/outcome"},
    "package_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bytes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
    "outcome": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "outcome_id", "run_id", "recipe", "provenance", "target_training_request", "effective_plan", "effective_plan_fingerprint", "selected_variant_id", "selected_variant_fingerprint", "output_bindings", "predictor_node_ids", "data_identities", "training_influence", "execution_bundle", "outcome_fingerprint"],
      "properties": {
        "schema_version": {"const": 3}, "outcome_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"},
        "recipe": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/portable_refit_recipe.v1.schema.json"},
        "provenance": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/portable_refit_provenance.v1.schema.json"},
        "target_training_request": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/training_request.v1.schema.json"},
        "effective_plan": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_plan.v1.schema.json"},
        "effective_plan_fingerprint": {"$ref": "#/$defs/sha256"}, "selected_variant_id": {"$ref": "#/$defs/id"}, "selected_variant_fingerprint": {"$ref": "#/$defs/sha256"},
        "output_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/output_binding.v1.schema.json"}},
        "predictor_node_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "data_identities": {"type": "array", "minItems": 1, "items": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/training_request.v1.schema.json#/$defs/training_data_identity"}},
        "training_influence": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/training_influence_manifest.v1.schema.json"},
        "execution_bundle": {"$ref": "#/$defs/execution_bundle"}, "outcome_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution_bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "bundle_id", "effective_plan_fingerprint", "selected_variant_id", "refit_artifacts", "raw_artifact_payloads", "bundle_fingerprint"],
      "properties": {
        "schema_version": {"const": 3}, "bundle_id": {"$ref": "#/$defs/id"}, "effective_plan_fingerprint": {"$ref": "#/$defs/sha256"}, "selected_variant_id": {"$ref": "#/$defs/id"},
        "refit_artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/refit_artifact_record"}},
        "raw_artifact_payloads": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/bytes"}},
        "bundle_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
