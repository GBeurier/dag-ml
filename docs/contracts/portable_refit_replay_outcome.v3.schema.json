{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/schemas/portable_refit_replay_outcome.v3.schema.json",
  "title": "DAG-ML PortableRefitReplayOutcome V3",
  "description": "Closed PREDICT/EXPLAIN evidence emitted from a PortableRefitPackage V3 child. It is not a TrainingReplayOutcome because its source is a fresh refit outcome rather than a CV/SELECT outcome.",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "outcome_id", "run_id", "source_package_fingerprint", "source_refit_outcome_fingerprint", "replay_request_id", "replay_request_fingerprint", "input_data_identities", "bundle_id", "plan_id", "phase", "outputs", "explanations", "lineage", "warnings", "diagnostics", "outcome_fingerprint"],
  "properties": {
    "schema_version": {"const": 3}, "outcome_id": {"$ref": "#/$defs/id"}, "run_id": {"$ref": "#/$defs/id"},
    "source_package_fingerprint": {"$ref": "#/$defs/sha256"}, "source_refit_outcome_fingerprint": {"$ref": "#/$defs/sha256"},
    "replay_request_id": {"$ref": "#/$defs/id"}, "replay_request_fingerprint": {"$ref": "#/$defs/sha256"},
    "input_data_identities": {"type": "array", "minItems": 1, "items": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/training_replay_outcome.v3.schema.json#/$defs/replay_data_identity"}},
    "bundle_id": {"$ref": "#/$defs/id"}, "plan_id": {"type": "string", "minLength": 1}, "phase": {"enum": ["PREDICT", "EXPLAIN"]},
    "outputs": {"type": "array", "items": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/bound_training_output.v2.schema.json"}},
    "explanations": {"type": "array", "items": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/node_result.v1.schema.json#/$defs/explanation_block"}},
    "lineage": {"type": "array", "items": {"$ref": "https://github.com/GBeurier/dag-ml/schemas/node_result.v1.schema.json#/$defs/lineage_record"}},
    "warnings": {"type": "array", "items": {"type": "string"}}, "diagnostics": {"type": "object", "additionalProperties": true},
    "outcome_fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
