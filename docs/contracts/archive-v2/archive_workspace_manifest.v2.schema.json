{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/contracts/archive-v2/archive_workspace_manifest.v2.schema.json",
  "title": "nirs4all native-portable archive V2 (SAVE-002 contract freeze)",
  "description": "Closed Archive V2 P0 manifest. This contract freezes dual-read dispatch and an intentionally Methods-only native-portable replay profile; it does not claim a reader or writer implementation or define every future native artifact policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "archive_id",
    "persistence_kind",
    "writer",
    "reader_dispatch",
    "physical_profile",
    "replay",
    "payloads",
    "member_inventory",
    "migration_provenance",
    "security",
    "workspace"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "profile": { "const": "nirs4all.archive_workspace.v2" },
    "archive_id": { "$ref": "#/$defs/id" },
    "persistence_kind": { "const": "n4a_archive" },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_aggregate_owner", "canonical_writer_id"],
      "properties": {
        "product_aggregate_owner": { "const": "nirs4all-core" },
        "canonical_writer_id": { "const": "nirs4all-core.archive_workspace_writer.v2" }
      }
    },
    "reader_dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archive_v2", "archive_v1", "legacy_n4a"],
      "properties": {
        "archive_v2": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted_versions", "future_versions", "dispatch_before_extraction"],
          "properties": {
            "accepted_versions": { "const": [2] },
            "future_versions": { "const": "refuse" },
            "dispatch_before_extraction": { "const": true }
          }
        },
        "archive_v1": {
          "type": "object",
          "additionalProperties": false,
          "required": ["accepted_versions", "read_mode", "mutation"],
          "properties": {
            "accepted_versions": { "const": [1] },
            "read_mode": { "const": "immutable_dual_read" },
            "mutation": { "const": "never_in_place" }
          }
        },
        "legacy_n4a": {
          "type": "object",
          "additionalProperties": false,
          "required": ["form", "manifest_member", "reader_id", "maximum_bundle_format_version", "migration_direction"],
          "properties": {
            "form": { "const": "historical_n4a_zip" },
            "manifest_member": { "const": "manifest.json" },
            "reader_id": { "const": "nirs4all.pipeline.bundle.loader.BundleLoader" },
            "maximum_bundle_format_version": { "const": "1.0" },
            "migration_direction": { "const": "legacy_to_v1_copy_on_write_only" }
          }
        }
      }
    },
    "physical_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["container", "manifest_member", "regular_files_only", "limits"],
      "properties": {
        "container": { "const": "zip" },
        "manifest_member": { "const": "manifest.json" },
        "regular_files_only": { "const": true },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_entries", "max_total_uncompressed_bytes", "max_member_uncompressed_bytes", "max_compression_ratio"],
          "properties": {
            "max_entries": { "const": 256 },
            "max_total_uncompressed_bytes": { "const": 536870912 },
            "max_member_uncompressed_bytes": { "const": 134217728 },
            "max_compression_ratio": { "const": 100 }
          }
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["portable_predictor_package", "training_artifacts", "future_artifacts"],
      "properties": {
        "portable_predictor_package": { "$ref": "#/$defs/portable_predictor_package_v2_ref" },
        "training_artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["graph", "execution_bundle", "training_outcome", "prediction_cache_payload_set", "score_set"],
          "properties": {
            "graph": { "$ref": "#/$defs/graph_v1_ref" },
            "execution_bundle": { "$ref": "#/$defs/execution_bundle_v2_ref" },
            "training_outcome": { "$ref": "#/$defs/training_outcome_v2_ref" },
            "prediction_cache_payload_set": { "$ref": "#/$defs/prediction_cache_payload_set_v2_ref" },
            "score_set": { "$ref": "#/$defs/score_set_v2_ref" }
          }
        },
        "future_artifacts": {
          "type": "array",
          "items": { "$ref": "#/$defs/deferred_artifact" }
        }
      }
    },
    "payloads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods", "n4d_aggregate_reference", "conformal", "robustness", "host_artifacts"],
      "properties": {
        "methods": {
          "type": "object",
          "additionalProperties": false,
          "required": ["n4mm", "n4mopt"],
          "properties": {
            "n4mm": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/n4mm_ref" }
            },
            "n4mopt": {
              "type": "array",
              "items": { "$ref": "#/$defs/n4mopt_ref" }
            }
          }
        },
        "n4d_aggregate_reference": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/n4d_aggregate_reference" }
          ]
        },
        "conformal": {
          "type": "null",
          "description": "Archive V2 conformal state belongs to PortablePredictorPackage V2; this retained V1 slot must be null."
        },
        "robustness": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/robustness_ref" }
          ]
        },
        "host_artifacts": {
          "type": "array",
          "maxItems": 0,
          "description": "Archive V2 P0 is native-portable only; host sidecars and external references are refused before write."
        }
      }
    },
    "member_inventory": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/member" }
    },
    "migration_provenance": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/archive_v1_migration_provenance" }
      ]
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrity_profile", "signature"],
      "properties": {
        "integrity_profile": { "const": "sha256_raw_member_inventory_v2" },
        "signature": { "type": "null" }
      }
    },
    "workspace": {
      "type": "null",
      "description": "Workspace snapshot writing is outside the native-only Archive V2 P0 contract."
    },
    "extensions": { "$ref": "#/$defs/extensions" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "member_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "semantic_profile": {
      "enum": ["dagml_tcv1", "dagml_historical_serde_json_v1", "n4mm_raw_sha256", "methods_rfc8785_jcs", "none"]
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "regular_file", "raw_sha256", "uncompressed_size_bytes", "semantic_fingerprint", "semantic_profile"],
      "properties": {
        "path": { "$ref": "#/$defs/member_path" },
        "regular_file": { "const": true },
        "raw_sha256": { "$ref": "#/$defs/sha256" },
        "uncompressed_size_bytes": { "type": "integer", "minimum": 0 },
        "semantic_fingerprint": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        },
        "semantic_profile": { "$ref": "#/$defs/semantic_profile" }
      }
    },
    "member_ref": {
      "type": "object",
      "required": ["member_path", "raw_sha256", "semantic_fingerprint", "semantic_profile"],
      "properties": {
        "member_path": { "$ref": "#/$defs/member_path" },
        "raw_sha256": { "$ref": "#/$defs/sha256" },
        "semantic_fingerprint": {
          "anyOf": [
            { "type": "null" },
            { "$ref": "#/$defs/sha256" }
          ]
        },
        "semantic_profile": { "$ref": "#/$defs/semantic_profile" }
      }
    },
    "portable_predictor_package_v2_ref": {
      "allOf": [
        { "$ref": "#/$defs/member_ref" },
        {
          "type": "object",
          "required": ["owner", "schema_id", "schema_version", "producer_port_required"],
          "properties": {
            "owner": { "const": "dag-ml" },
            "schema_id": { "const": "https://github.com/GBeurier/dag-ml/schemas/portable_predictor_package.v2.schema.json" },
            "schema_version": { "const": 2 },
            "producer_port_required": { "const": true },
            "member_path": { "const": "dagml/portable_predictor_package.json" },
            "semantic_fingerprint": { "$ref": "#/$defs/sha256" },
            "semantic_profile": { "const": "dagml_tcv1" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "graph_v1_ref": {
      "allOf": [
        { "$ref": "#/$defs/member_ref" },
        {
          "type": "object",
          "required": ["owner", "schema_id", "schema_version"],
          "properties": {
            "owner": { "const": "dag-ml" },
            "schema_id": { "const": "https://github.com/GBeurier/dag-ml/schemas/graph_spec.v1.schema.json" },
            "schema_version": { "const": 1 },
            "semantic_fingerprint": { "$ref": "#/$defs/sha256" },
            "semantic_profile": { "const": "dagml_historical_serde_json_v1" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "execution_bundle_v2_ref": {
      "$ref": "#/$defs/dagml_runtime_v2_execution_bundle"
    },
    "training_outcome_v2_ref": {
      "$ref": "#/$defs/dagml_runtime_v2_training_outcome"
    },
    "prediction_cache_payload_set_v2_ref": {
      "$ref": "#/$defs/dagml_runtime_v2_prediction_cache_payload_set"
    },
    "score_set_v2_ref": {
      "$ref": "#/$defs/dagml_runtime_v2_score_set"
    },
    "dagml_runtime_v2_execution_bundle": {
      "allOf": [
        { "$ref": "#/$defs/member_ref" },
        {
          "type": "object",
          "required": ["owner", "schema_id", "schema_version", "producer_port_required"],
          "properties": {
            "owner": { "const": "dag-ml" },
            "schema_id": { "const": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json" },
            "schema_version": { "const": 2 },
            "producer_port_required": { "const": true },
            "semantic_fingerprint": { "$ref": "#/$defs/sha256" },
            "semantic_profile": { "const": "dagml_tcv1" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "dagml_runtime_v2_training_outcome": {
      "allOf": [
        { "$ref": "#/$defs/member_ref" },
        {
          "type": "object",
          "required": ["owner", "schema_id", "schema_version", "producer_port_required"],
          "properties": {
            "owner": { "const": "dag-ml" },
            "schema_id": { "const": "https://github.com/GBeurier/dag-ml/schemas/training_outcome.v2.schema.json" },
            "schema_version": { "const": 2 },
            "producer_port_required": { "const": true },
            "semantic_fingerprint": { "$ref": "#/$defs/sha256" },
            "semantic_profile": { "const": "dagml_tcv1" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "dagml_runtime_v2_prediction_cache_payload_set": {
      "allOf": [
        { "$ref": "#/$defs/member_ref" },
        {
          "type": "object",
          "required": ["owner", "schema_id", "schema_version", "producer_port_required"],
          "properties": {
            "owner": { "const": "dag-ml" },
            "schema_id": { "const": "https://github.com/GBeurier/dag-ml/schemas/prediction_cache_payload_set.v2.schema.json" },
            "schema_version": { "const": 2 },
            "producer_port_required": { "const": true },
            "semantic_fingerprint": { "$ref": "#/$defs/sha256" },
            "semantic_profile": { "const": "dagml_historical_serde_json_v1" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "dagml_runtime_v2_score_set": {
      "allOf": [
        { "$ref": "#/$defs/member_ref" },
        {
          "type": "object",
          "required": ["owner", "schema_id", "schema_version", "producer_port_required"],
          "properties": {
            "owner": { "const": "dag-ml" },
            "schema_id": { "const": "https://github.com/GBeurier/dag-ml/schemas/score_set.v2.schema.json" },
            "schema_version": { "const": 2 },
            "producer_port_required": { "const": true },
            "semantic_fingerprint": { "$ref": "#/$defs/sha256" },
            "semantic_profile": { "const": "dagml_historical_serde_json_v1" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "n4mm_ref": {
      "allOf": [
        { "$ref": "#/$defs/member_ref" },
        {
          "type": "object",
          "required": ["artifact_id", "kind", "owner", "format_version", "abi_major"],
          "properties": {
            "artifact_id": { "$ref": "#/$defs/id" },
            "kind": { "const": "N4MM" },
            "owner": { "const": "nirs4all-methods" },
            "format_version": { "const": 1 },
            "abi_major": { "const": 2 },
            "abi_min_minor": { "type": "integer", "minimum": 0 },
            "member_path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^methods/[A-Za-z0-9][A-Za-z0-9_.-]*\\.n4mm$"
            },
            "semantic_fingerprint": { "$ref": "#/$defs/sha256" },
            "semantic_profile": { "const": "n4mm_raw_sha256" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "n4mopt_ref": {
      "allOf": [
        { "$ref": "#/$defs/member_ref" },
        {
          "type": "object",
          "required": ["kind", "owner", "format_version", "abi_major"],
          "properties": {
            "kind": { "const": "N4MOPT" },
            "owner": { "const": "nirs4all-methods" },
            "format_version": { "const": 1 },
            "abi_major": { "const": 2 },
            "abi_min_minor": { "type": "integer", "minimum": 0 },
            "semantic_fingerprint": { "$ref": "#/$defs/sha256" },
            "semantic_profile": { "const": "methods_rfc8785_jcs" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "n4d_aggregate_reference": {
      "allOf": [
        { "$ref": "#/$defs/member_ref" },
        {
          "type": "object",
          "required": ["kind", "owner", "interpretation"],
          "properties": {
            "kind": { "const": "n4d_aggregate_reference" },
            "owner": { "const": "nirs4all-core" },
            "interpretation": { "const": "aggregate_reference_not_n4d_format_claim" },
            "semantic_fingerprint": { "type": "null" },
            "semantic_profile": { "const": "none" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "robustness_ref": {
      "allOf": [
        { "$ref": "#/$defs/member_ref" },
        {
          "type": "object",
          "required": ["owner", "schema_id", "schema_version"],
          "properties": {
            "owner": { "const": "dag-ml" },
            "schema_id": { "const": "https://github.com/GBeurier/dag-ml/schemas/robustness_report.v1.schema.json" },
            "schema_version": { "const": 1 },
            "semantic_fingerprint": { "$ref": "#/$defs/sha256" },
            "semantic_profile": { "const": "dagml_tcv1" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "deferred_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "reason", "affects_replay"],
      "properties": {
        "kind": { "$ref": "#/$defs/id" },
        "status": { "const": "deferred_future_contract" },
        "reason": { "type": "string", "minLength": 1 },
        "affects_replay": { "const": false }
      }
    },
    "archive_v1_migration_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_raw_sha256", "source_schema_version", "source_profile", "tool_id", "tool_version", "copy_on_write", "source_retained"],
      "properties": {
        "source_raw_sha256": { "$ref": "#/$defs/sha256" },
        "source_schema_version": { "const": 1 },
        "source_profile": { "const": "nirs4all.archive_workspace.v1" },
        "tool_id": { "$ref": "#/$defs/id" },
        "tool_version": { "$ref": "#/$defs/id" },
        "copy_on_write": { "const": true },
        "source_retained": { "const": true }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_-]*(?:\\.[A-Za-z][A-Za-z0-9_-]*)+$"
      },
      "additionalProperties": true
    }
  }
}
