{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/schemas/artifact_facets.v1.schema.json",
  "title": "DAG-ML artifact facet declarations v1",
  "description": "Declarations, not executable authorization or validated proofs. Rust checks endpoint directions, IDs, requirements, exact ownership and supplied current owner proofs. Core owns container validation and admission binding. Unknown owner contents remain opaque.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifacts",
    "links"
  ],
  "properties": {
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "content_type": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty"
        },
        "version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "owner_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "schema",
        "schema_version",
        "fingerprint_profile",
        "fingerprint"
      ],
      "properties": {
        "owner": {
          "$ref": "#/$defs/nonempty"
        },
        "schema": {
          "$ref": "#/$defs/nonempty"
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "fingerprint_profile": {
          "$ref": "#/$defs/nonempty"
        },
        "fingerprint": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "requirement_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/nonempty"
        }
      },
      "description": "Minimal declared artifact ID reference; generic validation checks shape and existence only. Owner validates requirement meaning."
    },
    "storage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "root_member",
            "member_paths"
          ],
          "properties": {
            "kind": {
              "const": "embedded"
            },
            "root_member": {
              "$ref": "#/$defs/nonempty"
            },
            "member_paths": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/nonempty"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "reference"
            },
            "root_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      ],
      "description": "Reference root_sha256 may be omitted but must be a lowercase SHA-256 string when present, never null."
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "owner",
        "content_type",
        "identity",
        "storage",
        "requirements"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty"
        },
        "kind": {
          "enum": [
            "recipe",
            "dataset",
            "model",
            "run",
            "result",
            "score",
            "prediction",
            "residual",
            "training_evidence",
            "full_refit",
            "provenance",
            "attachment"
          ]
        },
        "owner": {
          "$ref": "#/$defs/nonempty"
        },
        "content_type": {
          "$ref": "#/$defs/content_type"
        },
        "identity": {
          "$ref": "#/$defs/owner_identity"
        },
        "storage": {
          "$ref": "#/$defs/storage"
        },
        "requirements": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/requirement_reference"
            }
          ]
        }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "relation",
        "source_artifact",
        "target_artifact"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nonempty"
        },
        "owner": {
          "$ref": "#/$defs/nonempty"
        },
        "relation": {
          "enum": [
            "recipe_of",
            "dataset_of",
            "produced_by",
            "evaluates",
            "residual_of",
            "evidence_for",
            "refit_of"
          ]
        },
        "source_artifact": {
          "$ref": "#/$defs/nonempty"
        },
        "target_artifact": {
          "$ref": "#/$defs/nonempty"
        }
      }
    }
  },
  "x-dagml-relation-directions": {
    "recipe_of": {
      "source_kinds": [
        "recipe"
      ],
      "target_kinds": [
        "run",
        "result",
        "training_evidence",
        "model",
        "full_refit"
      ]
    },
    "dataset_of": {
      "source_kinds": [
        "dataset"
      ],
      "target_kinds": [
        "run",
        "result",
        "training_evidence",
        "model",
        "prediction",
        "residual",
        "score",
        "full_refit"
      ]
    },
    "produced_by": {
      "source_kinds": [
        "model",
        "result",
        "training_evidence",
        "prediction",
        "residual",
        "score",
        "full_refit"
      ],
      "target_kinds": [
        "run"
      ]
    },
    "evaluates": {
      "source_kinds": [
        "score"
      ],
      "target_kinds": [
        "prediction",
        "result",
        "training_evidence"
      ]
    },
    "residual_of": {
      "source_kinds": [
        "residual"
      ],
      "target_kinds": [
        "prediction"
      ]
    },
    "evidence_for": {
      "source_kinds": [
        "training_evidence"
      ],
      "target_kinds": [
        "model"
      ]
    },
    "refit_of": {
      "source_kinds": [
        "full_refit"
      ],
      "target_kinds": [
        "training_evidence"
      ]
    }
  },
  "x-dagml-new-facet-profile-domain": "TCV1({profile: exact profile ID, content_type: {id, version}, payload: validated typed owner projection}); strict original-byte preflight and exact original-byte retention remain separate.",
  "x-dagml-facet-projection-profiles": [
    "dagml.facet.graph-spec.tcv1.v1",
    "dagml.facet.execution-bundle.tcv1.v1",
    "dagml.facet.score-set.tcv1.v1",
    "dagml.facet.prediction-cache-payload-set.tcv1.v1",
    "dagml.facet.execution-plan.tcv1.v1"
  ]
}
