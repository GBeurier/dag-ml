{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/contracts/archive-v3/archive_workspace_manifest.v3.schema.json",
  "title": "nirs4all target-bound native full-refit archive V3",
  "description": "Closed Archive V3 contract for ADR-25 full-refit children. V1/V2 are immutable predictor families and are not upgraded in place.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "archive_id", "persistence_kind", "writer", "reader_dispatch", "physical_profile", "replay", "payloads", "member_inventory", "migration_provenance", "security", "workspace"],
  "properties": {
    "schema_version": {"const": 3},
    "profile": {"const": "nirs4all.archive_workspace.v3"},
    "archive_id": {"$ref": "#/$defs/id"},
    "persistence_kind": {"const": "n4a_archive"},
    "writer": {"type": "object", "additionalProperties": false, "required": ["product_aggregate_owner", "canonical_writer_id"], "properties": {"product_aggregate_owner": {"const": "nirs4all-core"}, "canonical_writer_id": {"const": "nirs4all-core.archive_workspace_writer.v3"}}},
    "reader_dispatch": {"type": "object", "additionalProperties": false, "required": ["archive_v3", "archive_v2", "archive_v1"], "properties": {
      "archive_v3": {"$ref": "#/$defs/current_dispatch"},
      "archive_v2": {"$ref": "#/$defs/archive_v2_dispatch"},
      "archive_v1": {"$ref": "#/$defs/archive_v1_dispatch"}
    }},
    "physical_profile": {"type": "object", "additionalProperties": false, "required": ["container", "manifest_member", "regular_files_only", "limits"], "properties": {
      "container": {"const": "zip"}, "manifest_member": {"const": "manifest.json"}, "regular_files_only": {"const": true},
      "limits": {"type": "object", "additionalProperties": false, "required": ["max_entries", "max_total_uncompressed_bytes", "max_member_uncompressed_bytes", "max_compression_ratio"], "properties": {"max_entries": {"const": 256}, "max_total_uncompressed_bytes": {"const": 536870912}, "max_member_uncompressed_bytes": {"const": 134217728}, "max_compression_ratio": {"const": 100}}}
    }},
    "replay": {"type": "object", "additionalProperties": false, "required": ["portable_refit_package", "refit_artifacts", "future_artifacts"], "properties": {
      "portable_refit_package": {"$ref": "#/$defs/refit_package_ref"},
      "refit_artifacts": {"type": "object", "additionalProperties": false, "required": ["graph", "execution_bundle", "refit_outcome"], "properties": {
        "graph": {"$ref": "#/$defs/graph_ref"}, "execution_bundle": {"$ref": "#/$defs/refit_bundle_ref"}, "refit_outcome": {"$ref": "#/$defs/refit_outcome_ref"}
      }},
      "future_artifacts": {"type": "array", "maxItems": 0}
    }},
    "payloads": {"type": "object", "additionalProperties": false, "required": ["methods", "n4d_aggregate_reference", "conformal", "robustness", "host_artifacts"], "properties": {
      "methods": {"type": "object", "additionalProperties": false, "required": ["n4mm", "n4mopt"], "properties": {"n4mm": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/n4mm_ref"}}, "n4mopt": {"type": "array", "maxItems": 0}}},
      "n4d_aggregate_reference": {"type": "null"}, "conformal": {"type": "null"}, "robustness": {"type": "null"}, "host_artifacts": {"type": "array", "maxItems": 0}
    }},
    "member_inventory": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/member"}},
    "migration_provenance": {"type": "null"},
    "security": {"type": "object", "additionalProperties": false, "required": ["integrity_profile", "signature"], "properties": {"integrity_profile": {"const": "sha256_raw_member_inventory_v3"}, "signature": {"type": "null"}}},
    "workspace": {"type": "null"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.:-]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$"},
    "current_dispatch": {"type": "object", "additionalProperties": false, "required": ["accepted_versions", "future_versions", "dispatch_before_extraction"], "properties": {"accepted_versions": {"const": [3]}, "future_versions": {"const": "refuse"}, "dispatch_before_extraction": {"const": true}}},
    "archive_v2_dispatch": {"type": "object", "additionalProperties": false, "required": ["accepted_versions", "read_mode", "mutation"], "properties": {"accepted_versions": {"const": [2]}, "read_mode": {"const": "immutable_dual_read"}, "mutation": {"const": "never_in_place"}}},
    "archive_v1_dispatch": {"type": "object", "additionalProperties": false, "required": ["accepted_versions", "read_mode", "mutation"], "properties": {"accepted_versions": {"const": [1]}, "read_mode": {"const": "immutable_dual_read"}, "mutation": {"const": "never_in_place"}}},
    "member": {"type": "object", "additionalProperties": false, "required": ["path", "regular_file", "raw_sha256", "uncompressed_size_bytes", "semantic_fingerprint", "semantic_profile"], "properties": {"path": {"$ref": "#/$defs/path"}, "regular_file": {"const": true}, "raw_sha256": {"$ref": "#/$defs/sha256"}, "uncompressed_size_bytes": {"type": "integer", "minimum": 0}, "semantic_fingerprint": {"$ref": "#/$defs/sha256"}, "semantic_profile": {"enum": ["dagml_tcv1", "dagml_historical_serde_json_v1", "n4mm_raw_sha256"]}}},
    "dag_ref": {"type": "object", "additionalProperties": false, "required": ["owner", "schema_id", "schema_version", "member_path", "raw_sha256", "semantic_fingerprint", "semantic_profile"], "properties": {"owner": {"const": "dag-ml"}, "schema_id": {"type": "string"}, "schema_version": {"type": "integer", "minimum": 1}, "member_path": {"$ref": "#/$defs/path"}, "raw_sha256": {"$ref": "#/$defs/sha256"}, "semantic_fingerprint": {"$ref": "#/$defs/sha256"}, "semantic_profile": {"enum": ["dagml_tcv1", "dagml_historical_serde_json_v1"]}, "producer_port_required": {"type": "boolean"}}},
    "refit_package_ref": {"allOf": [{"$ref": "#/$defs/dag_ref"}, {"properties": {"schema_id": {"const": "https://github.com/GBeurier/dag-ml/schemas/portable_refit_package.v3.schema.json"}, "schema_version": {"const": 3}, "member_path": {"const": "dagml/portable_refit_package.json"}, "semantic_profile": {"const": "dagml_tcv1"}, "producer_port_required": {"const": true}}, "required": ["producer_port_required"]}]},
    "graph_ref": {"allOf": [{"$ref": "#/$defs/dag_ref"}, {"properties": {"schema_id": {"const": "https://github.com/GBeurier/dag-ml/schemas/graph_spec.v1.schema.json"}, "schema_version": {"const": 1}, "member_path": {"const": "dagml/graph.json"}, "semantic_profile": {"const": "dagml_historical_serde_json_v1"}}}]},
    "refit_bundle_ref": {"allOf": [{"$ref": "#/$defs/dag_ref"}, {"properties": {"schema_id": {"const": "https://github.com/GBeurier/dag-ml/schemas/portable_refit_execution_bundle.v3.schema.json"}, "schema_version": {"const": 3}, "member_path": {"const": "dagml/portable_refit_execution_bundle.json"}, "semantic_profile": {"const": "dagml_tcv1"}, "producer_port_required": {"const": true}}, "required": ["producer_port_required"]}]},
    "refit_outcome_ref": {"allOf": [{"$ref": "#/$defs/dag_ref"}, {"properties": {"schema_id": {"const": "https://github.com/GBeurier/dag-ml/schemas/portable_refit_outcome.v3.schema.json"}, "schema_version": {"const": 3}, "member_path": {"const": "dagml/portable_refit_outcome.json"}, "semantic_profile": {"const": "dagml_tcv1"}, "producer_port_required": {"const": true}}, "required": ["producer_port_required"]}]},
    "n4mm_ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "kind", "owner", "format_version", "abi_major", "member_path", "raw_sha256", "semantic_fingerprint", "semantic_profile"], "properties": {"artifact_id": {"$ref": "#/$defs/id"}, "kind": {"const": "N4MM"}, "owner": {"const": "nirs4all-methods"}, "format_version": {"enum": [1, 2]}, "abi_major": {"const": 2}, "abi_min_minor": {"type": "integer", "minimum": 0}, "member_path": {"type": "string", "pattern": "^methods/[A-Za-z0-9._-]+\\.n4mm$"}, "raw_sha256": {"$ref": "#/$defs/sha256"}, "semantic_fingerprint": {"$ref": "#/$defs/sha256"}, "semantic_profile": {"const": "n4mm_raw_sha256"}}}
  }
}
