{
  "profile": "nirs4all.archive_workspace.refusals.v3",
  "description": "Archive V3 storage-only refusal cases. Each case mutates the positive manifest (op/path/value arrays, as in refusals.v2.json; additionally `append`) and/or the synthetic payload bytes, then must be refused with the stated category. No case asserts rejection of a future Methods ABI minor: that is a replay-time capability owned by the Methods runtime, not a storage property.",
  "cases": [
    {
      "id": "future_archive_v4_is_refused",
      "base": "archive_v3",
      "mutations": [
        {
          "op": "replace",
          "path": [
            "schema_version"
          ],
          "value": 4
        }
      ],
      "expected_error": "schema_refusal"
    },
    {
      "id": "future_archive_v999_is_refused",
      "base": "archive_v3",
      "mutations": [
        {
          "op": "replace",
          "path": [
            "schema_version"
