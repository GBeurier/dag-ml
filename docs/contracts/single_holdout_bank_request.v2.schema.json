{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/schemas/single_holdout_bank_request.v2.schema.json",
  "title": "Single resampled holdout classification bank request v2",
  "description": "Native accuracy, maximized, over ClassLabel ids on the actual Resampled validation fold. Ties keep the first ordinal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "failure_group_dimension", "target_node"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"const": "single_resampled_holdout_bank.v2"},
    "failure_group_dimension": {"type": "string", "minLength": 1},
    "target_node": {"type": "string", "minLength": 1}
  }
}
