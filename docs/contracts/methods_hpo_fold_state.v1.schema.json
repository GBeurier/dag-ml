{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/schemas/methods_hpo_fold_state.v1.schema.json",
  "title": "DAG-ML MethodsFoldHpoState v1",
  "description": "Complete, closed native PLS fold-HPO evidence. Native validation additionally verifies root/scope provenance, exact training universes and groups, global fold identity, every terminal ledger and REFIT selection. Resume requires the complete validated Package V2, not this state alone.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "target_node_id",
    "base_plan",
    "selected_variant_id",
    "provenance",
    "relations",
    "outer_scopes",
    "refit_scope"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "operation_id": {
      "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/identifier"
    },
    "target_node_id": {
      "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/identifier"
    },
    "base_plan": {
      "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_plan.v1.schema.json"
    },
    "selected_variant_id": {
      "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/identifier"
    },
    "provenance": {
      "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/methods_hpo_resume_provenance"
    },
    "outer_scopes": {
      "type": "array",
      "minItems": 2,
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/scope"
          },
          {
            "properties": {
              "phase": {
                "const": "FIT_CV"
              },
              "outer_fold_id": {
                "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/identifier"
              }
            }
          }
        ]
      }
    },
    "refit_scope": {
      "allOf": [
        {
          "$ref": "#/$defs/scope"
        },
        {
          "properties": {
            "phase": {
              "const": "REFIT"
            },
            "outer_fold_id": {
              "type": "null"
            }
          }
        }
      ]
    },
    "relations": {
      "$ref": "https://github.com/GBeurier/dag-ml/schemas/coordinator_data_plan_envelope.v1.schema.json#/$defs/coordinator_relation_set",
      "description": "Root coordinator relation authority; native validation checks its fingerprint and derives each scope subset for group/origin/exclusion leakage guards. Contains no feature or target buffers."
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id",
        "phase",
        "outer_fold_id",
        "inner_fold_set",
        "scope_plan_fingerprint",
        "winner_variant_id",
        "winner_params",
        "params_fingerprint",
        "resume_state"
      ],
      "properties": {
        "scope_id": {
          "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/identifier"
        },
        "phase": {
          "enum": [
            "FIT_CV",
            "REFIT"
          ]
        },
        "outer_fold_id": {
          "anyOf": [
            {
              "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/identifier"
            },
            {
              "type": "null"
            }
          ]
        },
        "inner_fold_set": {
          "$ref": "#/$defs/inner_fold_set"
        },
        "scope_plan_fingerprint": {
          "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/sha256"
        },
        "winner_variant_id": {
          "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/identifier"
        },
        "winner_params": {
          "$ref": "#/$defs/winner_params"
        },
        "params_fingerprint": {
          "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/sha256"
        },
        "resume_state": {
          "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/methods_hpo_resume_state"
        }
      }
    },
    "winner_params": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "n_components": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "scale": {
          "type": "boolean"
        }
      },
      "description": "Only searched axes, retaining public bool/int values; fixed base/train/refit controls are not included."
    },
    "inner_fold_set": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sample_ids",
        "folds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "sample_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/identifier"
          }
        },
        "folds": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_plan.v1.schema.json#/$defs/fold_assignment"
          }
        },
        "sample_groups": {
          "type": "object",
          "additionalProperties": {
            "$ref": "https://github.com/GBeurier/dag-ml/schemas/execution_bundle.v2.schema.json#/$defs/identifier"
          },
          "default": {}
        },
        "partition_mode": {
          "const": "partition",
          "default": "partition"
        },
        "train_exclusion": {
          "enum": [
            "relations",
            "fold_local"
          ],
          "default": "relations"
        }
      }
    }
  }
}
