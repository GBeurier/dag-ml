{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/schemas/score_set.v2.schema.json",
  "title": "DAG-ML ScoreSet v2",
  "description": "Port-explicit ScoreSet for collision-free multi-port scoring. All V1 report constraints are preserved; producer_port is the port-identity addition. Optional metric_profile/undefined_metrics carry finite, opt-in report diagnostics without changing legacy report bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "reports"],
  "properties": {
    "schema_version": { "type": "integer", "const": 2 },
    "plan_id": { "type": "string", "minLength": 1 },
    "selection_metric": { "type": ["string", "null"] },
    "reports": {
      "type": "array",
      "items": { "$ref": "#/$defs/regression_metric_report" }
    }
  },
  "$defs": {
    "regression_metric_report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producer_node", "producer_port", "partition", "level", "row_count", "target_width", "metrics"],
      "properties": {
        "target_domain": { "anyOf": [{ "$ref": "https://github.com/GBeurier/dag-ml/schemas/target_domain.v1.schema.json" }, { "type": "null" }] },
        "prediction_id": { "type": ["string", "null"] },
        "variant_id": { "type": ["string", "null"] },
        "variant_label": { "type": ["string", "null"] },
        "producer_node": { "type": "string", "minLength": 1 },
        "producer_port": { "type": "string", "minLength": 1 },
        "partition": { "enum": ["train", "validation", "test", "final"] },
        "fold_id": { "type": ["string", "null"] },
        "level": { "enum": ["observation", "sample", "target", "group"] },
        "row_count": { "type": "integer", "minimum": 0 },
        "target_width": { "type": "integer", "minimum": 0 },
        "target_names": { "type": "array", "items": { "type": "string" } },
        "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
        "metric_profile": {"enum": [null, "regression_report.population_rmse_ratios.v1"]},
        "undefined_metrics": {"type": "object", "additionalProperties": false, "properties": {"r2": {"const": "constant_target"}, "rpd": {"const": "zero_rmse"}, "rpiq": {"const": "zero_rmse"}}},
        "grouping_key": {
          "$ref": "#/$defs/aggregation_grouping_key"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "grouping_key"
            ]
          },
          "then": {
            "required": [
              "level"
            ],
            "properties": {
              "level": {
                "const": "group"
              }
            }
          }
        },
        {"if": {"required": ["undefined_metrics"], "properties": {"undefined_metrics": {"minProperties": 1}}}, "then": {"required": ["metric_profile"], "properties": {"metric_profile": {"const": "regression_report.population_rmse_ratios.v1"}}}},
        {"if": {"required": ["metric_profile"], "properties": {"metric_profile": {"type": "string"}}}, "then": {"properties": {"metrics": {"required": ["rmse"]}}}},
        {"if": {"required": ["undefined_metrics"], "properties": {"undefined_metrics": {"required": ["r2"]}}}, "then": {"properties": {"metrics": {"not": {"required": ["r2"]}}}}},
        {"if": {"required": ["undefined_metrics"], "properties": {"undefined_metrics": {"required": ["rpd"]}}}, "then": {"properties": {"metrics": {"not": {"required": ["rpd"]}}}}},
        {"if": {"required": ["undefined_metrics"], "properties": {"undefined_metrics": {"required": ["rpiq"]}}}, "then": {"properties": {"metrics": {"not": {"required": ["rpiq"]}}}}}
      ]
    },
    "aggregation_grouping_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "key"
      ],
      "properties": {
        "kind": {
          "const": "relation_metadata"
        },
        "key": {
          "const": "independent_unit_id"
        }
      }
    }
  },
  "allOf": [
    {"if": {"required": ["selection_metric"], "properties": {"selection_metric": {"not": {"enum": [null, "rmse"]}}}}, "then": {"properties": {"reports": {"items": {"properties": {"metric_profile": {"type": "null"}}}}}}}
  ]
}
