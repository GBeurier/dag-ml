{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/schemas/training_bank_request.v1.schema.json",
  "title": "DAG no-split training bank request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "failure_group_dimension", "target_node"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"enum": ["training_bank.v1", "training_graph_bank.v1"]},
    "failure_group_dimension": {"type": "string", "minLength": 1},
    "target_node": {"type": "string", "minLength": 1}
  }
}
