{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/schemas/target_domain.v1.schema.json",
  "title": "Fitted categorical target domain v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recipe_fingerprint",
    "state_json",
    "state_fingerprint",
    "fit_sample_ids",
    "class_labels"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "recipe_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 1048576
    },
    "state_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "fit_sample_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "class_labels": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "number"
      }
    }
  }
}
