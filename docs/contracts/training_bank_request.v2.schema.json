{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/GBeurier/dag-ml/schemas/training_bank_request.v2.schema.json",
  "title": "DAG no-split classification training bank request v2",
  "description": "Native resubstitution accuracy, maximized, over ClassLabel ids on all rows (Train scope). Ties keep the first ordinal.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "failure_group_dimension", "target_node"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"enum": ["training_bank.v2", "training_graph_classification_bank.v1"]},
    "failure_group_dimension": {"type": "string", "minLength": 1},
    "target_node": {"type": "string", "minLength": 1}
  }
}
