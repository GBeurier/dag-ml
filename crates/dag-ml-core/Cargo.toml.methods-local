[package]
name = "dag-ml-core"
description = "Core graph, phase, OOF and deterministic control contracts for dag-ml."
version.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
authors.workspace = true
repository.workspace = true
homepage.workspace = true
readme = "README.md"
exclude = ["Cargo.toml.methods-local"]

[features]
default = []
methods-optimizer = ["dep:n4m"]
# Native integration tests are deliberately excluded from the publishable
# manifest and run only through scripts/test_methods_optimizer_local.sh.
methods-optimizer-local = ["methods-optimizer"]

[lints.rust]
unexpected_cfgs = { level = "warn", check-cfg = ['cfg(feature, values("methods-optimizer", "methods-optimizer-local"))', 'cfg(dag_ml_workspace_contract_fixtures)'] }

[dependencies]
serde.workspace = true
serde_ignored.workspace = true
serde_json.workspace = true
yaml_serde.workspace = true
indexmap.workspace = true
sha2.workspace = true
thiserror.workspace = true
tracing.workspace = true
unicode-normalization.workspace = true
n4m = { version = "0.1.1", default-features = false, features = ["dynamic"], optional = true }

[dev-dependencies]
nirs4all_archive_core = { package = "nirs4all", version = "0.3.15" }
